class_name ParkBuilder
extends Node3D
## Central park inside CityGrid.PARK_RECT. Layout mirrors scripts/world/park/sim_poisson.py:
## elliptical ring path, 2 diagonals, 4 spokes to a central plaza with the fountain, a pond on the
## west spoke crossed by the bridge, a low wall with an entrance on every side, a playground.
## Trees come from data/props/park_trees.json (Poisson-disc, generated by sim_poisson.py):
## one MultiMesh per species/variant per 128 m chunk, trunk capsules on layer 7, canopy
## anchors ('anchorable' marker + layer-1 sphere so web rays hit them).
## The lawn, path and water surfaces are code meshes with real materials (allowed by the brief).

const TREES_JSON: String = "res://data/props/park_trees.json"
const PARK_DIR: String = "res://assets/models/park/"
const RING_A: float = 180.0
const RING_B: float = 80.0
const RING_W: float = 5.0
const DIAG_W: float = 4.0
const SPOKE_W: float = 4.0
const PLAZA_R: float = 18.0
const POND: Vector4 = Vector4(-112.0, 210.0, 30.0, 17.0)
const PLAYGROUND: Vector2 = Vector2(110.0, 160.0)
const PATH_Y: float = 0.06
const LAWN_Y: float = 0.03
const CANOPY_FRACTION: float = 0.72

var rect: Rect2 = CityGrid.PARK_RECT
var center: Vector3
var tree_count: int = 0
var path_points: PackedVector3Array = PackedVector3Array()  # sample points on paths (teleport, QA)
var _batch: InstanceBatcher = InstanceBatcher.new()
var _manifest: Dictionary = {}
var _solids: Array[Vector3] = []  # (x, z, radius) of solid park props already placed


func build(streamer: ChunkStreamer) -> void:
	name = "Park"
	center = Vector3(rect.get_center().x, 0.0, rect.get_center().y)
	for e: Variant in PropPlacer.load_manifest():
		_manifest[str((e as Dictionary).get("id", ""))] = e
	_ground()
	_paths()
	_pond_and_bridge()
	_wall()
	_features()
	_trees()
	_batch.flush(self, streamer)


func get_teleport_point() -> Vector3:
	# South spoke, 10 m inside the south entrance (always a path).
	return Vector3(center.x, 1.0, rect.position.y + 10.0)


# ------------------------------------------------------------------ surfaces

func _mat(c: Color, rough: float) -> StandardMaterial3D:
	var m: StandardMaterial3D = StandardMaterial3D.new()
	m.albedo_color = c
	m.roughness = rough
	# Fine noise so the large surfaces read as grass / gravel, not a flat colour.
	var nt: NoiseTexture2D = NoiseTexture2D.new()
	var fn: FastNoiseLite = FastNoiseLite.new()
	fn.frequency = 0.08
	nt.noise = fn
	nt.seamless = true
	nt.width = 256
	nt.height = 256
	m.albedo_texture = nt
	m.uv1_scale = Vector3(0.25, 0.25, 0.25)
	m.uv1_triplanar = true
	return m


func _ground() -> void:
	var lawn: MeshInstance3D = MeshInstance3D.new()
	var pm: PlaneMesh = PlaneMesh.new()
	pm.size = rect.size
	lawn.mesh = pm
	lawn.material_override = _mat(Color(0.25, 0.45, 0.19), 0.95)
	lawn.position = center + Vector3.UP * LAWN_Y
	lawn.name = "Lawn"
	add_child(lawn)


## Path ribbons merged into one mesh: ring (polyline), diagonals, spokes, plaza disc.
func _paths() -> void:
	var st: SurfaceTool = SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	var ring: PackedVector3Array = PackedVector3Array()
	for i: int in 96:
		var a: float = TAU * float(i) / 96.0
		ring.append(center + Vector3(cos(a) * RING_A, 0.0, sin(a) * RING_B))
	for i: int in ring.size():
		_ribbon(st, ring[i], ring[(i + 1) % ring.size()], RING_W)
		if i % 6 == 0:
			path_points.append(ring[i])
	var m: float = 3.0
	var segs: Array = [
		[Vector3(rect.position.x + m, 0, rect.position.y + m), Vector3(rect.end.x - m, 0, rect.end.y - m), DIAG_W],
		[Vector3(rect.position.x + m, 0, rect.end.y - m), Vector3(rect.end.x - m, 0, rect.position.y + m), DIAG_W],
		[Vector3(center.x, 0, rect.position.y), Vector3(center.x, 0, center.z - PLAZA_R), SPOKE_W],
		[Vector3(center.x, 0, center.z + PLAZA_R), Vector3(center.x, 0, rect.end.y), SPOKE_W],
		[Vector3(rect.position.x, 0, center.z), Vector3(center.x - PLAZA_R, 0, center.z), SPOKE_W],
		[Vector3(center.x + PLAZA_R, 0, center.z), Vector3(rect.end.x, 0, center.z), SPOKE_W],
	]
	for s: Array in segs:
		_ribbon(st, s[0], s[1], float(s[2]))
		var a2: Vector3 = s[0]
		var b2: Vector3 = s[1]
		var n: int = maxi(2, int(a2.distance_to(b2) / 30.0))
		for k: int in n + 1:
			path_points.append(a2.lerp(b2, float(k) / float(n)))
	# Plaza disc.
	var c: Vector3 = center + Vector3.UP * PATH_Y
	for i: int in 48:
		var a0: float = TAU * float(i) / 48.0
		var a1: float = TAU * float(i + 1) / 48.0
		st.set_normal(Vector3.UP)
		st.add_vertex(c)
		st.add_vertex(c + Vector3(cos(a1), 0, sin(a1)) * PLAZA_R)
		st.add_vertex(c + Vector3(cos(a0), 0, sin(a0)) * PLAZA_R)
	var mi: MeshInstance3D = MeshInstance3D.new()
	mi.name = "Paths"
	mi.mesh = st.commit()
	# Paths and plaza: paving tiles with seams and per-tile variation (Godot-built mesh).
	var pave: ShaderMaterial = ShaderMaterial.new()
	pave.shader = load("res://shaders/paving.gdshader") as Shader
	pave.set_shader_parameter(&"base_color", Color(0.62, 0.57, 0.48))
	pave.set_shader_parameter(&"seam_color", Color(0.36, 0.33, 0.28))
	pave.set_shader_parameter(&"tile_size", 0.6)
	pave.set_shader_parameter(&"running_bond", 1.0)
	mi.material_override = pave
	mi.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	add_child(mi)


func _ribbon(st: SurfaceTool, a: Vector3, b: Vector3, w: float) -> void:
	var d: Vector3 = (b - a)
	d.y = 0.0
	if d.length_squared() < 0.0001:
		return
	var side: Vector3 = d.normalized().cross(Vector3.UP) * (w * 0.5)
	# Extend slightly so polyline joints have no gaps.
	var ext: Vector3 = d.normalized() * (w * 0.25)
	var y: Vector3 = Vector3.UP * PATH_Y
	var p0: Vector3 = a - ext - side + y
	var p1: Vector3 = a - ext + side + y
	var p2: Vector3 = b + ext + side + y
	var p3: Vector3 = b + ext - side + y
	for v: Vector3 in [p0, p2, p1, p0, p3, p2]:
		st.set_normal(Vector3.UP)
		st.add_vertex(v)


# ------------------------------------------------------------------ features

func _add(id: String, xf: Transform3D, variant: int = -1) -> bool:
	var e: Dictionary = _manifest.get(id, {}) as Dictionary
	# Footprint radius from the manifest size; skip when it would overlap a solid placed earlier.
	var sz: Array = e.get("size", [1, 1, 1]) as Array
	var r: float = maxf(float(sz[0]), float(sz[2])) * 0.5 * xf.basis.get_scale().x
	var solid: bool = str(e.get("collider", "none")) != "none" and id != "park_wall"
	if solid:
		var q: Vector2 = Vector2(xf.origin.x, xf.origin.z)
		var cr: float = r if not id.begins_with("tree_") else 1.0
		for o: Vector3 in _solids:
			if q.distance_to(Vector2(o.x, o.y)) < cr + o.z:
				return false
		_solids.append(Vector3(q.x, q.y, cr))
	var col: Dictionary = {}
	var ct: String = str(e.get("collider", "none"))
	if ct != "none":
		var cz: Array = e.get("collider_size", [0, 0, 0]) as Array
		col = {"type": ct, "size": Vector3(float(cz[0]), float(cz[1]), float(cz[2]))}
	return _batch.add(id, str(e.get("model", _prop_path(id))), xf, variant, col)


func _pond_and_bridge() -> void:
	var water: MeshInstance3D = MeshInstance3D.new()
	water.name = "Pond"
	var cm: CylinderMesh = CylinderMesh.new()
	cm.top_radius = 1.0
	cm.bottom_radius = 1.0
	cm.height = 0.02
	cm.radial_segments = 48
	water.mesh = cm
	var wm: ShaderMaterial = ShaderMaterial.new()
	wm.shader = load("res://shaders/water.gdshader")
	water.material_override = wm
	water.scale = Vector3(POND.z, 1.0, POND.w)
	water.position = Vector3(POND.x, LAWN_Y + 0.02, POND.y)
	add_child(water)
	# Bridge on the west spoke over the pond (glb long axis is local Z, so turn it along X).
	_add("bridge", Transform3D(Basis(Vector3.UP, PI * 0.5), Vector3(POND.x, 0.0, POND.y)))
	# Rocks around the pond edge.
	for i: int in 10:
		var a: float = TAU * (float(i) + 0.3) / 10.0
		var p: Vector3 = Vector3(POND.x + cos(a) * (POND.z + 1.8), 0.0, POND.y + sin(a) * (POND.w + 1.8))
		if absf(p.z - POND.y) > SPOKE_W:
			_add("rock", Transform3D(Basis(Vector3.UP, a * 3.1), p))


## Low wall along the park edge with 4 m gaps at every path entrance (spokes + diagonals).
func _wall() -> void:
	var gaps_x: Array[float] = [center.x, rect.position.x + 3.0, rect.end.x - 3.0]
	var gaps_z: Array[float] = [center.z, rect.position.y + 3.0, rect.end.y - 3.0]
	for zside: float in [rect.position.y + 0.3, rect.end.y - 0.3]:
		var x: float = rect.position.x + 2.0
		while x < rect.end.x - 1.9:
			if not _in_gap(x, gaps_x, 4.5) and not _near_crossing(x, zside):
				_add("park_wall", Transform3D(Basis.IDENTITY, Vector3(x, 0.0, zside)))
			x += 4.0
	for xside: float in [rect.position.x + 0.3, rect.end.x - 0.3]:
		var z: float = rect.position.y + 2.0
		while z < rect.end.y - 1.9:
			if not _in_gap(z, gaps_z, 4.5) and not _near_crossing(xside, z):
				_add("park_wall", Transform3D(Basis(Vector3.UP, PI * 0.5), Vector3(xside, 0.0, z)))
			z += 4.0


## Corner signals of the intersections on the park edge stand within ~14 m of the crossing.
func _near_crossing(x: float, z: float) -> bool:
	for c: Vector3 in CityGrid.intersections():
		if absf(c.x - x) < CityGrid.STREET_WIDTH * 0.5 + 2.5 and absf(c.z - z) < CityGrid.AVE_WIDTH * 0.5 + 2.5:
			return true
		if Vector2(c.x - x, c.z - z).length() < 4.0:
			return true
	return false


func _in_gap(v: float, gaps: Array[float], half: float) -> bool:
	for g: float in gaps:
		if absf(v - g) < half:
			return true
	return false


func _features() -> void:
	_add("fountain", Transform3D(Basis.IDENTITY, center))
	PropPlacer.add_anchor_body(self, center + Vector3.UP * 3.6, 0.5)
	_add("statue", Transform3D(Basis(Vector3.UP, PI), Vector3(center.x, 0.0, rect.position.y + 24.0) + Vector3(5.0, 0, 0)))
	_add("playground", Transform3D(Basis.IDENTITY, Vector3(PLAYGROUND.x, 0.0, PLAYGROUND.y)))
	# Benches / lanterns / hedges along the spokes, picnic tables on lawns near the plaza.
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = 9137
	for i: int in path_points.size():
		var p: Vector3 = path_points[i]
		if absf(p.x - POND.x) < POND.z + 4.0 and absf(p.z - POND.y) < POND.w + 4.0:
			continue
		if p.distance_to(center) < PLAZA_R + 3.0:
			continue
		var off: Vector3 = Vector3(3.6, 0, 0) if absf(p.z - center.z) < 1.0 else Vector3(0, 0, 3.6)
		if Vector2(p.x - PLAYGROUND.x, p.z - PLAYGROUND.y).length() < 8.0:
			continue
		if i % 2 == 0:
			if _add("lamp_lantern", Transform3D(Basis.IDENTITY, p + off), -1):
				PropPlacer.add_anchor_body(self, p + off + Vector3.UP * 4.0, 0.3)
		elif rng.randf() < 0.6:
			_add("bench", Transform3D(Basis.looking_at(-off.normalized(), Vector3.UP), p - off * 0.95), -1)
	for i: int in 8:
		var a: float = TAU * float(i) / 8.0 + 0.4
		_add("hedge", Transform3D(Basis(Vector3.UP, -a), center + Vector3(cos(a), 0, sin(a)) * (PLAZA_R + 1.4)))
	for i: int in 6:
		var a2: float = TAU * float(i) / 6.0
		_add("picnic_table", Transform3D(Basis(Vector3.UP, a2), Vector3(70.0 + cos(a2) * 9.0, 0.0, 255.0 + sin(a2) * 6.0)))


## Fallback when the manifest has no entry: lantern and bench live under props/ in the contract.
func _prop_path(id: String) -> String:
	return "res://assets/models/props/" + id + ".glb" if id in ["lamp_lantern", "bench"] else PARK_DIR + id + ".glb"


## Trees from park_trees.json: [x, z, species, yaw, scale]. LOD0 only for now (LOD1/billboard
## swap is a lead follow-up once those glbs exist).
func _trees() -> void:
	if not FileAccess.file_exists(TREES_JSON):
		print("[ParkBuilder] tree list missing, run scripts/world/park/sim_poisson.py: ", TREES_JSON)
		return
	var data: Variant = JSON.parse_string(FileAccess.get_file_as_string(TREES_JSON))
	if not (data is Dictionary):
		print("[ParkBuilder] tree list unreadable")
		return
	var species: Array = (data as Dictionary).get("species", []) as Array
	var anchors: Node3D = Node3D.new()
	anchors.name = "TreeAnchors"
	add_child(anchors)
	for t: Variant in (data as Dictionary).get("trees", []) as Array:
		var row: Array = t as Array
		var id: String = str(species[int(row[2])])
		var sc: float = float(row[4])
		var p: Vector3 = Vector3(float(row[0]), 0.0, float(row[1]))
		var xf: Transform3D = Transform3D(Basis(Vector3.UP, float(row[3])).scaled(Vector3.ONE * sc), p)
		if not _add(id, xf):
			continue
		tree_count += 1
		var e: Dictionary = _manifest.get(id, {}) as Dictionary
		var sz: Array = e.get("size", [6, 10, 6]) as Array
		var top: Vector3 = p + Vector3.UP * float(sz[1]) * sc * CANOPY_FRACTION
		var m: Marker3D = Marker3D.new()
		m.position = top
		m.set_meta(&"anchor_point", top)
		m.set_meta(&"prop_id", id)
		m.add_to_group(&"anchorable")
		anchors.add_child(m)
		PropPlacer.add_anchor_body(anchors, top, 0.9)
