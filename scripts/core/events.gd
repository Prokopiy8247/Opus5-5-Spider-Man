extends Node
## Global signal bus (autoload "Events"). Signals only, exactly as in docs/CONTRACTS.md.

@warning_ignore_start("unused_signal")
signal player_state_changed(old: StringName, new: StringName)
signal web_attached(anchor: Vector3, hand: StringName)
signal web_released()
signal zip_started(target: Vector3)
signal point_launch()
signal landed(impact_speed: float, hero_land: bool)
signal hit_landed(target: Node3D, damage: float, combo: int)
signal player_damaged(amount: float, from_dir: Vector3)
signal combo_changed(count: int)
signal focus_changed(value: float)
signal health_changed(value: float)
signal spider_sense(attacker: Node3D, perfect_window: bool)
signal perfect_dodge()
signal finisher_started(target: Node3D, id: StringName)
signal finisher_ended()
signal enemy_state_changed(enemy: Node3D, state: StringName)
signal base_alarm(base_id: StringName)
signal base_cleared(base_id: StringName)
signal wave_started(base_id: StringName, wave: int)
signal gadget_used(id: StringName)
signal xp_gained(amount: int, reason: StringName)
signal level_up(level: int)
signal skill_unlocked(id: StringName)
signal suit_changed(id: StringName)
signal time_of_day_changed(hour: float)
signal debug_teleport(point: StringName)
@warning_ignore_restore("unused_signal")
